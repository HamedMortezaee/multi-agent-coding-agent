        "jsCode": "const input = $json;\n\nlet payload = null;\n\nif (input.body?.message?.text) {\n  try {\n    payload = JSON.parse(input.body.message.text);\n  } catch (error) {\n    throw new Error('body.message.text must contain valid JSON.');\n  }\n} else if (input.body?.action) {\n  payload = input.body;\n} else if (input.action) {\n  payload = input;\n} else {\n  throw new Error('No supported request payload found.');\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      action: payload.action ?? null,\n      request: payload.request ?? null,\n      requestedBy: payload.requestedBy ?? null,\n      executionId: payload.executionId ?? null,\n      decision: payload.decision ?? null,\n      feedback: payload.feedback ?? null,\n      chatId: input.body?.message?.chat?.id ?? null,\n      messageId: input.body?.message?.message_id ?? null\n    }\n  }\n];"
